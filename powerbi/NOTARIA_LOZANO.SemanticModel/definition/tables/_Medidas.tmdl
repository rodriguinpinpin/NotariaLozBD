	measure 'Atencion minima minutos' = MIN(FACT_TIEMPOS_ATENCION[Minutos_Totales])
		formatString: #,##0
		displayFolder: Operaciones
		lineageTag: 1b08c945-21d8-493b-8323-81eafae851fa

	measure 'Atencion maxima minutos' = MAX(FACT_TIEMPOS_ATENCION[Minutos_Totales])
		formatString: #,##0
		displayFolder: Operaciones
		lineageTag: 5b1cbb12-4a24-4c1f-ac62-e321177c3c38

	measure 'Espera sobre total declarado' = DIVIDE(SUM(FACT_TIEMPOS_ATENCION[Minutos_Espera]), SUM(FACT_TIEMPOS_ATENCION[Minutos_Totales]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operaciones
		lineageTag: f3bb8488-e541-4fb7-b662-5c2da10d7313

	/// Tiempo total de las 4 etapas por trámite.
	measure 'Minutos por tramite' = DIVIDE(SUM(FACT_TIEMPOS_ATENCION[Minutos_Totales]), DISTINCTCOUNT(FACT_TIEMPOS_ATENCION[Nro_Tramite]))
		formatString: #,##0.0
		displayFolder: Operaciones
