table _Medidas
	lineageTag: f19ff6b0-d234-44a6-9f29-29a54d745172

	/// Suma de pagos en estado Pagado (dinero recibido).
	measure 'Importe cobrado' = SUM(FACT_TRAMITES_FINANCIEROS[Monto_Cobrado])
		formatString: \S\/\ #,##0.00
		displayFolder: Finanzas
		lineageTag: 1a9212d8-67a9-408c-ae4b-a9c25197b696

	/// Importe emitido de trámites no anulados.
	measure 'Importe facturado' = CALCULATE(SUM(FACT_TRAMITE_GENERAL[Monto_Arancel]), FACT_TRAMITE_GENERAL[Estado_Tramite] <> "Anulado")
		formatString: \S\/\ #,##0.00
		displayFolder: Finanzas
		lineageTag: 08dd1a3d-e1e9-4895-8727-b8781bb8c050

	/// Pagos en estado Pendiente.
	measure 'Por cobrar' = SUM(FACT_TRAMITES_FINANCIEROS[Monto_Pendiente])
		formatString: \S\/\ #,##0.00
		displayFolder: Finanzas
		lineageTag: 3967a528-595b-45a5-a7b5-b848cfa5c803

	/// Costo (insumos, tasas) del importe cobrado.
	measure 'Costo asociado' = SUM(FACT_TRAMITES_FINANCIEROS[Costo_Asociado])
		formatString: \S\/\ #,##0.00
		displayFolder: Finanzas
		lineageTag: 13400337-903d-476a-83f8-4d29862af3ae

	/// Importe cobrado menos costo asociado. No es utilidad neta.
	measure Margen = [Importe cobrado] - [Costo asociado]
		formatString: \S\/\ #,##0.00
		displayFolder: Finanzas
		lineageTag: 4edb28aa-b474-4050-82bd-cf6af4658c95

	measure '% Margen' = DIVIDE([Margen], [Importe cobrado])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Finanzas
		lineageTag: 3680d5dd-daa6-441c-bf68-9819aaa863ad

	/// Filas del hecho financiero (un pago por fila).
	measure 'Registros financieros' = COUNTROWS(FACT_TRAMITES_FINANCIEROS)
		formatString: #,##0
		displayFolder: Finanzas
		lineageTag: c1954c8c-25db-4fae-90fa-2fa136d08291

	measure 'Registros con monto' = CALCULATE(COUNTROWS(FACT_TRAMITES_FINANCIEROS), FACT_TRAMITES_FINANCIEROS[Monto_Cobrado] > 0)
		formatString: #,##0
		displayFolder: Finanzas
		lineageTag: 3dc11c6e-4555-48a7-8bbf-a20afbecd3ed

	measure 'Importe medio por registro' = DIVIDE([Importe cobrado], [Registros con monto])
		formatString: \S\/\ #,##0.00
		displayFolder: Finanzas
		lineageTag: 2fe47a05-c50b-4ca5-be93-383f3dea189a

	/// Importe cobrado por trámite con pago.
	measure 'Ticket medio' = DIVIDE([Importe cobrado], CALCULATE(DISTINCTCOUNT(FACT_TRAMITES_FINANCIEROS[Nro_Tramite]), FACT_TRAMITES_FINANCIEROS[Monto_Cobrado] > 0))
		formatString: \S\/\ #,##0.00
		displayFolder: Finanzas
		lineageTag: 6ca512f4-1552-48b4-b0b5-946e23158fdd

	measure '% Efectivo' = DIVIDE(CALCULATE([Importe cobrado], DIM_METODO_PAGO[Tipo_Pago] = "Efectivo"), [Importe cobrado])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Finanzas
		lineageTag: 05e0f1ac-a334-45e1-b249-86bab07b3c05

	/// P2: importe cobrado con método Efectivo.
	measure 'Cobrado en efectivo' = CALCULATE([Importe cobrado], DIM_METODO_PAGO[Tipo_Pago] = "Efectivo")
		formatString: \S\/\ #,##0.00
		displayFolder: Finanzas
		lineageTag: fbe32c8b-dd7c-47ca-9148-cd1f0196a26e

	measure '% Digital' = DIVIDE(CALCULATE([Importe cobrado], DIM_METODO_PAGO[Canal] = "Digital"), [Importe cobrado])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Finanzas
		lineageTag: 27dc086e-40f4-40fe-8b91-ed155cb33718

	/// Cobrado sobre cobrado + por cobrar.
	measure '% Cobranza' = DIVIDE([Importe cobrado], [Importe cobrado] + [Por cobrar])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Finanzas
		lineageTag: 9cabb138-57a3-4ac8-bcc0-f0288265330b

	measure 'Cobrado mes actual' =
			VAR FechaFin = MAX(DIM_TIEMPO[Fecha_Exacta])
			VAR FechaIni = MAX(MIN(DIM_TIEMPO[Fecha_Exacta]), DATE(YEAR(FechaFin), MONTH(FechaFin), 1))
			VAR Actual = CALCULATE([Importe cobrado], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= FechaIni && DIM_TIEMPO[Fecha_Exacta] <= FechaFin))
			VAR Anterior = CALCULATE([Importe cobrado], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= EDATE(FechaIni, -1) && DIM_TIEMPO[Fecha_Exacta] <= EDATE(FechaFin, -1)))
			RETURN Actual
		formatString: \S\/\ #,##0.00
		displayFolder: Finanzas\Variación
		lineageTag: 7610c04f-cad0-4bee-930a-239398f68763

	measure 'Cobrado mes anterior' =
			VAR FechaFin = MAX(DIM_TIEMPO[Fecha_Exacta])
			VAR FechaIni = MAX(MIN(DIM_TIEMPO[Fecha_Exacta]), DATE(YEAR(FechaFin), MONTH(FechaFin), 1))
			VAR Actual = CALCULATE([Importe cobrado], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= FechaIni && DIM_TIEMPO[Fecha_Exacta] <= FechaFin))
			VAR Anterior = CALCULATE([Importe cobrado], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= EDATE(FechaIni, -1) && DIM_TIEMPO[Fecha_Exacta] <= EDATE(FechaFin, -1)))
			RETURN Anterior
		formatString: \S\/\ #,##0.00
		displayFolder: Finanzas\Variación
		lineageTag: f158e020-4222-41de-9a5b-d5e10142f149

	/// Último mes del contexto (a la fecha) frente a los mismos días del mes anterior.
	measure 'Variacion mensual cobros' =
			VAR FechaFin = MAX(DIM_TIEMPO[Fecha_Exacta])
			VAR FechaIni = MAX(MIN(DIM_TIEMPO[Fecha_Exacta]), DATE(YEAR(FechaFin), MONTH(FechaFin), 1))
			VAR Actual = CALCULATE([Importe cobrado], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= FechaIni && DIM_TIEMPO[Fecha_Exacta] <= FechaFin))
			VAR Anterior = CALCULATE([Importe cobrado], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= EDATE(FechaIni, -1) && DIM_TIEMPO[Fecha_Exacta] <= EDATE(FechaFin, -1)))
			RETURN DIVIDE(Actual - Anterior, Anterior)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Finanzas\Variación
		lineageTag: b1b66cb8-442c-4759-a09c-4af678f3f41e

	measure 'Tramites registrados' = DISTINCTCOUNT(FACT_TRAMITE_GENERAL[Nro_Tramite])
		formatString: #,##0
		displayFolder: Trámites
		lineageTag: 243753ac-e25c-404d-93ee-1f1cbe1c6fa7

	measure 'Cantidad de tramites' = SUM(FACT_TRAMITE_GENERAL[Cantidad_Tramites])
		formatString: #,##0
		displayFolder: Trámites
		lineageTag: 1d78c666-aee2-415e-801f-fa40981c6842

	measure 'Pagos registrados' = CALCULATE(COUNTROWS(FACT_TRAMITE_GENERAL), FACT_TRAMITE_GENERAL[Monto_Pagado] > 0)
		formatString: #,##0
		displayFolder: Trámites
		lineageTag: 5b758aa9-bb10-417a-9f0b-5a5a8869c86b

	measure 'Importe pagado tramites' = SUM(FACT_TRAMITE_GENERAL[Monto_Pagado])
		formatString: \S\/\ #,##0.00
		displayFolder: Trámites
		lineageTag: 264126cf-9109-43bb-ad3d-0f7866029501

	/// P4: trámites de la categoría Escrituras públicas.
	measure 'Tramites escrituras publicas' = CALCULATE([Tramites registrados], DIM_SERVICIO[Categoria] = "Escrituras públicas")
		formatString: #,##0
		displayFolder: Trámites
		lineageTag: 0755b583-a253-46bb-91e5-f94108cd67f1

	measure 'Tramites finalizados' = CALCULATE([Tramites registrados], FACT_TRAMITE_GENERAL[Estado_Tramite] = "Finalizado")
		formatString: #,##0
		displayFolder: Trámites
		lineageTag: dacdf4d5-fca7-46e9-b8d4-914e344ddae0

	measure 'Tramites en proceso' = CALCULATE([Tramites registrados], FACT_TRAMITE_GENERAL[Estado_Tramite] IN {"En Proceso", "Observado"})
		formatString: #,##0
		displayFolder: Trámites
		lineageTag: f40dd435-c681-4492-a04a-9e8b1c305ccb

	/// Finalizados sobre trámites no anulados.
	measure 'Tasa de finalizacion' = DIVIDE([Tramites finalizados], CALCULATE([Tramites registrados], FACT_TRAMITE_GENERAL[Estado_Tramite] <> "Anulado"))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Trámites
		lineageTag: c14ba3a5-596a-4094-8ef9-3b0807eb5fef

	/// Días entre inicio y fin de trámites finalizados.
	measure 'Dias promedio de duracion' = AVERAGE(FACT_TRAMITE_GENERAL[Dias_Duracion])
		formatString: #,##0.0
		displayFolder: Trámites
		lineageTag: a8f4a88d-66d4-427a-ac3c-9850813c7b4a

	measure 'Tramites mes actual' =
			VAR FechaFin = MAX(DIM_TIEMPO[Fecha_Exacta])
			VAR FechaIni = MAX(MIN(DIM_TIEMPO[Fecha_Exacta]), DATE(YEAR(FechaFin), MONTH(FechaFin), 1))
			VAR Actual = CALCULATE([Tramites registrados], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= FechaIni && DIM_TIEMPO[Fecha_Exacta] <= FechaFin))
			VAR Anterior = CALCULATE([Tramites registrados], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= EDATE(FechaIni, -1) && DIM_TIEMPO[Fecha_Exacta] <= EDATE(FechaFin, -1)))
			RETURN Actual
		formatString: #,##0
		displayFolder: Trámites
		lineageTag: bc6bb59a-76d6-4b89-8a0b-99c97c46da19

	measure 'Variacion mensual tramites' =
			VAR FechaFin = MAX(DIM_TIEMPO[Fecha_Exacta])
			VAR FechaIni = MAX(MIN(DIM_TIEMPO[Fecha_Exacta]), DATE(YEAR(FechaFin), MONTH(FechaFin), 1))
			VAR Actual = CALCULATE([Tramites registrados], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= FechaIni && DIM_TIEMPO[Fecha_Exacta] <= FechaFin))
			VAR Anterior = CALCULATE([Tramites registrados], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= EDATE(FechaIni, -1) && DIM_TIEMPO[Fecha_Exacta] <= EDATE(FechaFin, -1)))
			RETURN DIVIDE(Actual - Anterior, Anterior)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Trámites
		lineageTag: 3824234f-9715-41d1-aa20-1a7b3af72f14

	/// Registros de atención (trámite x etapa).
	measure 'Atenciones registradas' = COUNTROWS(FACT_TIEMPOS_ATENCION)
		formatString: #,##0
		displayFolder: Operaciones
		lineageTag: ec9a89e5-4c72-4f14-88b3-6e4c0d654118

	measure 'Atencion media minutos' = AVERAGE(FACT_TIEMPOS_ATENCION[Minutos_Totales])
		formatString: #,##0.0
		displayFolder: Operaciones
		lineageTag: 13bf37d1-0775-4ba7-8143-6b980c4814cc

	measure 'Espera media minutos' = AVERAGE(FACT_TIEMPOS_ATENCION[Minutos_Espera])
		formatString: #,##0.0
		displayFolder: Operaciones
		lineageTag: 6b60b2eb-abf5-41d5-b1ef-4ea1af00caeb

	measure 'Proceso medio minutos' = AVERAGE(FACT_TIEMPOS_ATENCION[Minutos_Proceso])
		formatString: #,##0.0
		displayFolder: Operaciones
