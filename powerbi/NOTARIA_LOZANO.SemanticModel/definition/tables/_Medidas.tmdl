	measure 'Documentos otorgados' = SUM(FACT_DOCUMENTOS_OTORGADOS[Cantidad_Documentos])
		formatString: #,##0
		displayFolder: Documentos
		lineageTag: 12cd6423-0720-4c64-9d66-3d6ad31910d3

	measure 'Tipos documentales atendidos' = CALCULATE(DISTINCTCOUNT(FACT_DOCUMENTOS_OTORGADOS[ID_TipoDocumento]), FACT_DOCUMENTOS_OTORGADOS[Cantidad_Documentos] > 0)
		formatString: #,##0
		displayFolder: Documentos
		lineageTag: 6b74fe5a-de9e-4081-b7dd-697000576469

	measure 'Documentos por tramite' = DIVIDE([Documentos otorgados], DISTINCTCOUNT(FACT_DOCUMENTOS_OTORGADOS[Nro_Tramite]))
		formatString: #,##0.0
		displayFolder: Documentos
		lineageTag: 30a004b0-6b07-47a9-a95e-f7e5d04af54b

	measure 'Documentos mes anterior' =
			VAR FechaFin = MAX(DIM_TIEMPO[Fecha_Exacta])
			VAR FechaIni = MAX(MIN(DIM_TIEMPO[Fecha_Exacta]), DATE(YEAR(FechaFin), MONTH(FechaFin), 1))
			VAR Actual = CALCULATE([Documentos otorgados], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= FechaIni && DIM_TIEMPO[Fecha_Exacta] <= FechaFin))
			VAR Anterior = CALCULATE([Documentos otorgados], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= EDATE(FechaIni, -1) && DIM_TIEMPO[Fecha_Exacta] <= EDATE(FechaFin, -1)))
			RETURN Anterior
		formatString: #,##0
		displayFolder: Documentos
		lineageTag: e60caa8f-d04d-4c51-8287-a538bbdc32da

	measure 'Variacion mensual documentos' =
			VAR FechaFin = MAX(DIM_TIEMPO[Fecha_Exacta])
			VAR FechaIni = MAX(MIN(DIM_TIEMPO[Fecha_Exacta]), DATE(YEAR(FechaFin), MONTH(FechaFin), 1))
			VAR Actual = CALCULATE([Documentos otorgados], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= FechaIni && DIM_TIEMPO[Fecha_Exacta] <= FechaFin))
			VAR Anterior = CALCULATE([Documentos otorgados], FILTER(ALL(DIM_TIEMPO), DIM_TIEMPO[Fecha_Exacta] >= EDATE(FechaIni, -1) && DIM_TIEMPO[Fecha_Exacta] <= EDATE(FechaFin, -1)))
			RETURN DIVIDE(Actual - Anterior, Anterior)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Documentos
		lineageTag: 6cf230b2-22f5-4aa9-95f4-9084774ea0b7

	measure 'Clientes unicos' = DISTINCTCOUNT(FACT_TRAMITE_GENERAL[ID_Cliente])
		formatString: #,##0
		displayFolder: Clientes
		lineageTag: a4d3e6c1-c79f-43dd-9c53-ce615827b183

	/// Clientes con más de un trámite en el contexto.
	measure 'Clientes recurrentes' = COUNTROWS(FILTER(VALUES(FACT_TRAMITE_GENERAL[ID_Cliente]), CALCULATE([Tramites registrados]) > 1))
		formatString: #,##0
		displayFolder: Clientes
		lineageTag: 017b4a9e-29e8-4ceb-b8ec-0442c3e6cf60

	measure '% Recurrencia' = DIVIDE([Clientes recurrentes], [Clientes unicos])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Clientes
		lineageTag: 92d8dbf8-cea2-46b2-8be1-c32f78c9c13e

	measure 'Tramites por cliente' = DIVIDE([Tramites registrados], [Clientes unicos])
		formatString: #,##0.0
		displayFolder: Clientes
		lineageTag: 93b9ff8e-fe9b-42f4-a344-602fec31e00e

	measure 'Clientes juridicos' = CALCULATE([Clientes unicos], DIM_CLIENTE[Tipo_Cliente] = "Juridica")
		formatString: #,##0
