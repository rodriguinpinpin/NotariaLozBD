		lineageTag: c7920d11-07b6-4c94-8730-21295cb0d609

	measure 'Importe por cliente' = DIVIDE([Importe cobrado], [Clientes unicos])
		formatString: \S\/\ #,##0.00
		displayFolder: Clientes
