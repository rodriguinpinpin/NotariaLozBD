	measure 'Color variacion cobros' = IF([Variacion mensual cobros] < 0, "#FF8A9C", "#6EE7C4")
		displayFolder: Visual
		lineageTag: 08ac20fa-1fda-4dc1-9998-5e7acf5ea89f

	measure 'Color variacion documentos' = IF([Variacion mensual documentos] < 0, "#FF8A9C", "#6EE7C4")
		displayFolder: Visual
		lineageTag: f855a123-8702-462e-a126-577a67c06f52

	measure 'Texto variacion cobros' =
			VAR v = [Variacion mensual cobros]
			RETURN IF(ISBLANK(v), "Sin mes anterior", IF(v >= 0, "▲ ", "▼ ") & FORMAT(ABS(v), "0.0%") & " vs mes anterior")
		displayFolder: Visual
		lineageTag: 9667452d-d065-48e9-b7c8-6a7cb196be74

	measure 'Texto variacion documentos' =
			VAR v = [Variacion mensual documentos]
			RETURN IF(ISBLANK(v), "Sin mes anterior", IF(v >= 0, "▲ ", "▼ ") & FORMAT(ABS(v), "0.0%") & " vs mes anterior")
		displayFolder: Visual
		lineageTag: 0b4b0e0e-859c-44fc-ae0c-8f53d9f52948

	measure 'Texto periodo' = "Periodo: " & FORMAT(MIN(DIM_TIEMPO[Fecha_Exacta]), "dd mmm yyyy") & " – " & FORMAT(MAX(DIM_TIEMPO[Fecha_Exacta]), "dd mmm yyyy")
		displayFolder: Visual
		lineageTag: a49f74bb-adc8-4958-b0b7-d061ae07aa85

	measure 'SVG tendencia cobrado' =
			VAR T = CALCULATETABLE(ADDCOLUMNS(VALUES(DIM_TIEMPO[Orden_Mes]), "@v", [Importe cobrado] + 0), ALLSELECTED(DIM_TIEMPO), DIM_TIEMPO[Mes_Completo] = TRUE())
			VAR N = COUNTROWS(T)
			VAR MinV = MINX(T, [@v])
			VAR MaxV = MAXX(T, [@v])
			VAR Pts = CONCATENATEX(T,
			    VAR i = RANKX(T, DIM_TIEMPO[Orden_Mes], , ASC)
			    RETURN INT(DIVIDE((i - 1) * 196, N - 1) + 2) & "," & INT(52 - DIVIDE([@v] - MinV, MaxV - MinV) * 44),
			    " ", DIM_TIEMPO[Orden_Mes], ASC)
			VAR Svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 60' preserveAspectRatio='none'>"
			    & "<polygon fill='%230876AA' fill-opacity='0.14' points='2,58 " & Pts & " 198,58'/>"
			    & "<polyline fill='none' stroke='%230876AA' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' stroke-dasharray='600' points='" & Pts & "'>"
			    & "<animate attributeName='stroke-dashoffset' from='600' to='0' dur='1.4s' fill='freeze'/></polyline></svg>"
			RETURN IF(N > 1, "data:image/svg+xml;utf8," & Svg)
		displayFolder: Visual
		lineageTag: 39f8415c-e55e-4ed1-979f-36f88cd901ef
		dataCategory: ImageUrl

	measure 'SVG tendencia tramites' =
			VAR T = CALCULATETABLE(ADDCOLUMNS(VALUES(DIM_TIEMPO[Orden_Mes]), "@v", [Tramites registrados] + 0), ALLSELECTED(DIM_TIEMPO), DIM_TIEMPO[Mes_Completo] = TRUE())
			VAR N = COUNTROWS(T)
			VAR MinV = MINX(T, [@v])
			VAR MaxV = MAXX(T, [@v])
			VAR Pts = CONCATENATEX(T,
			    VAR i = RANKX(T, DIM_TIEMPO[Orden_Mes], , ASC)
			    RETURN INT(DIVIDE((i - 1) * 196, N - 1) + 2) & "," & INT(52 - DIVIDE([@v] - MinV, MaxV - MinV) * 44),
			    " ", DIM_TIEMPO[Orden_Mes], ASC)
			VAR Svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 60' preserveAspectRatio='none'>"
			    & "<polygon fill='%23BE263E' fill-opacity='0.14' points='2,58 " & Pts & " 198,58'/>"
			    & "<polyline fill='none' stroke='%23BE263E' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' stroke-dasharray='600' points='" & Pts & "'>"
			    & "<animate attributeName='stroke-dashoffset' from='600' to='0' dur='1.4s' fill='freeze'/></polyline></svg>"
			RETURN IF(N > 1, "data:image/svg+xml;utf8," & Svg)
		displayFolder: Visual
		lineageTag: c9930eb5-ca50-4b89-add5-7f9ace130f3f
		dataCategory: ImageUrl

	measure 'SVG tendencia atencion' =
			VAR T = CALCULATETABLE(ADDCOLUMNS(VALUES(DIM_TIEMPO[Orden_Mes]), "@v", [Atencion media minutos] + 0), ALLSELECTED(DIM_TIEMPO), DIM_TIEMPO[Mes_Completo] = TRUE())
			VAR N = COUNTROWS(T)
			VAR MinV = MINX(T, [@v])
			VAR MaxV = MAXX(T, [@v])
			VAR Pts = CONCATENATEX(T,
			    VAR i = RANKX(T, DIM_TIEMPO[Orden_Mes], , ASC)
			    RETURN INT(DIVIDE((i - 1) * 196, N - 1) + 2) & "," & INT(52 - DIVIDE([@v] - MinV, MaxV - MinV) * 44),
			    " ", DIM_TIEMPO[Orden_Mes], ASC)
			VAR Svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 60' preserveAspectRatio='none'>"
			    & "<polygon fill='%23168D9C' fill-opacity='0.14' points='2,58 " & Pts & " 198,58'/>"
			    & "<polyline fill='none' stroke='%23168D9C' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' stroke-dasharray='600' points='" & Pts & "'>"
			    & "<animate attributeName='stroke-dashoffset' from='600' to='0' dur='1.4s' fill='freeze'/></polyline></svg>"
			RETURN IF(N > 1, "data:image/svg+xml;utf8," & Svg)
		displayFolder: Visual
		lineageTag: 1379bf64-4013-4445-bd91-2791f3de5467
		dataCategory: ImageUrl

	measure 'SVG tendencia documentos' =
			VAR T = CALCULATETABLE(ADDCOLUMNS(VALUES(DIM_TIEMPO[Orden_Mes]), "@v", [Documentos otorgados] + 0), ALLSELECTED(DIM_TIEMPO), DIM_TIEMPO[Mes_Completo] = TRUE())
			VAR N = COUNTROWS(T)
			VAR MinV = MINX(T, [@v])
			VAR MaxV = MAXX(T, [@v])
			VAR Pts = CONCATENATEX(T,
			    VAR i = RANKX(T, DIM_TIEMPO[Orden_Mes], , ASC)
			    RETURN INT(DIVIDE((i - 1) * 196, N - 1) + 2) & "," & INT(52 - DIVIDE([@v] - MinV, MaxV - MinV) * 44),
			    " ", DIM_TIEMPO[Orden_Mes], ASC)
			VAR Svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 60' preserveAspectRatio='none'>"
			    & "<polygon fill='%23173D64' fill-opacity='0.14' points='2,58 " & Pts & " 198,58'/>"
			    & "<polyline fill='none' stroke='%23173D64' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' stroke-dasharray='600' points='" & Pts & "'>"
			    & "<animate attributeName='stroke-dashoffset' from='600' to='0' dur='1.4s' fill='freeze'/></polyline></svg>"
			RETURN IF(N > 1, "data:image/svg+xml;utf8," & Svg)
		displayFolder: Visual
		lineageTag: 75e1f7a7-193c-4c45-a1c7-91e8cb569134
