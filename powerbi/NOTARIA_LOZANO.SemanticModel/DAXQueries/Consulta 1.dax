DEFINE
MEASURE FACT_TRAMITES_FINANCIEROS[Importe cobrado] = SUM(FACT_TRAMITES_FINANCIEROS[Monto_Cobrado])
MEASURE FACT_TRAMITES_FINANCIEROS[Registros financieros] = COUNTROWS(FACT_TRAMITES_FINANCIEROS)
MEASURE FACT_TRAMITES_FINANCIEROS[Importe medio por registro] = DIVIDE([Importe cobrado],[Registros financieros])
MEASURE FACT_TRAMITES_FINANCIEROS[Registros con monto] = COUNT(FACT_TRAMITES_FINANCIEROS[Monto_Cobrado])
MEASURE FACT_TRAMITES_FINANCIEROS[Costo asociado] = SUM(FACT_TRAMITES_FINANCIEROS[Costo_Asociado])
MEASURE FACT_TIEMPOS_ATENCION[Atenciones registradas] = COUNTROWS(FACT_TIEMPOS_ATENCION)
MEASURE FACT_TIEMPOS_ATENCION[Atencion media minutos] = AVERAGE(FACT_TIEMPOS_ATENCION[Minutos_Totales])
MEASURE FACT_TIEMPOS_ATENCION[Espera media minutos] = AVERAGE(FACT_TIEMPOS_ATENCION[Minutos_Espera])
MEASURE FACT_TIEMPOS_ATENCION[Proceso medio minutos] = AVERAGE(FACT_TIEMPOS_ATENCION[Minutos_Proceso])
MEASURE FACT_TIEMPOS_ATENCION[Atencion minima minutos] = MIN(FACT_TIEMPOS_ATENCION[Minutos_Totales])
MEASURE FACT_TIEMPOS_ATENCION[Atencion maxima minutos] = MAX(FACT_TIEMPOS_ATENCION[Minutos_Totales])
MEASURE FACT_DOCUMENTOS_OTORGADOS[Documentos otorgados] = SUM(FACT_DOCUMENTOS_OTORGADOS[Cantidad_Documentos])
MEASURE FACT_DOCUMENTOS_OTORGADOS[Tipos documentales atendidos] = COUNTROWS(FILTER(VALUES(DIM_TIPO_DOCUMENTO[ID_TipoDocumento]), NOT ISBLANK(DIM_TIPO_DOCUMENTO[ID_TipoDocumento]) && CALCULATE([Documentos otorgados])>0))
MEASURE FACT_TRAMITE_GENERAL[Tramites registrados] = DISTINCTCOUNT(FACT_TRAMITE_GENERAL[Nro_Tramite])
MEASURE FACT_TRAMITE_GENERAL[Cantidad de tramites] = SUM(FACT_TRAMITE_GENERAL[Cantidad_Tramites])
MEASURE FACT_TRAMITE_GENERAL[Pagos registrados] = COUNTROWS(FILTER(FACT_TRAMITE_GENERAL, NOT ISBLANK(FACT_TRAMITE_GENERAL[Monto_Pagado]) && FACT_TRAMITE_GENERAL[Monto_Pagado]>0))
MEASURE FACT_TRAMITE_GENERAL[Importe pagado tramites] = SUM(FACT_TRAMITE_GENERAL[Monto_Pagado])
EVALUATE ROW("Cobrado",[Importe cobrado],"Registros",[Registros financieros],"Media",[Importe medio por registro],"Atenciones",[Atenciones registradas],"Minutos",[Atencion media minutos],"Documentos",[Documentos otorgados],"Tramites",[Tramites registrados])